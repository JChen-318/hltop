<?xml version="1.0" encoding="UTF-8"?>
<component type="console-application">
    <id>io.github.jchen_318.hltop</id>

    <name>hltop</name>
    <summary>Intel Gaudi accelerator process monitor</summary>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>
    <developer_name>JChen-318 and nvtop contributors</developer_name>

    <description>
        <p>Hltop is an nvtop-based, htop-like task monitor for Intel Gaudi accelerators. It handles multiple AIPs and keeps nvtop's familiar terminal interface.</p>
    </description>

    <launchable type="desktop-id">hltop.desktop</launchable>

    <icon type="cached">nvtop.svg</icon>

    <categories>
        <category>System</category>
        <category>Monitor</category>
    </categories>

    <url type="homepage">https://github.com/JChen-318/hltop</url>

    <screenshots>
        <screenshot type="default">
            <caption>The nvtop interface</caption>
            <image>https://raw.githubusercontent.com/Syllo/nvtop/master/screenshot/NVTOP_ex1.png</image>
        </screenshot>
        <screenshot>
            <caption>The nvtop option screen</caption>
            <image>https://raw.githubusercontent.com/Syllo/nvtop/master/screenshot/Nvtop-config.png</image>
        </screenshot>
    </screenshots>

    <provides>
        <binary>hltop</binary>
    </provides>
    <releases>
    <release version="@PROJECT_VERSION@" date="@TODAY_ISO_8601@"></release>
    </releases>
</component>
